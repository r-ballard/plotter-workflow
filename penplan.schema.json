{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified DPX-3300 physical plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "policy": {
      "enum": [
        "preserve",
        "compact",
        "explicit"
      ]
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assignments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assignments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layer_ids",
                "physical_slot"
              ],
              "properties": {
                "layer_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                },
                "physical_slot": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                }
              }
            }
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "omitted_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "repeated_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "pen_force": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "software",
            "panel"
          ]
        },
        "default_gf": {
          "type": "integer",
          "enum": [
            20,
            35,
            50,
            65,
            80,
            95,
            110,
            125
          ]
        },
        "slot_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "force_gf"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "force_gf": {
                "type": "integer",
                "enum": [
                  20,
                  35,
                  50,
                  65,
                  80,
                  95,
                  110,
                  125
                ]
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "default_gf"
          ]
        },
        {
          "required": [
            "slot_overrides"
          ],
          "properties": {
            "slot_overrides": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "explicit"
          }
        }
      },
      "then": {
        "required": [
          "passes"
        ]
      },
      "else": {
        "not": {
          "required": [
            "passes"
          ]
        },
        "properties": {
          "repeated_layers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
