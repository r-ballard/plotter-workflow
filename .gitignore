# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv-managed local environment
.venv/

# Local environment and editor state
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Distribution/build artifacts
build/
dist/
*.egg-info/

# Plotter job inputs and generated output
# Keep the directories themselves in Git via their .gitkeep files.
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Optional local working areas
scratch/
tmp/

# Serial/debug logs
*.log
