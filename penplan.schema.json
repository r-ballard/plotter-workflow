{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plotter-workflow/penplan.schema.json",
  "title": "DPX-3300 user pen plan",
  "description": "User-authored logical-layer to physical-carriage configuration for plotter-workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "enum": ["preserve", "compact", "explicit"]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_layer", "physical_slot"],
        "properties": {
          "logical_layer": {"type": "integer", "minimum": 1, "maximum": 8},
          "physical_slot": {"type": "integer", "minimum": 1, "maximum": 8}
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot"],
        "properties": {
          "slot": {"type": "integer", "minimum": 1, "maximum": 8},
          "tool": {"type": "string", "minLength": 1},
          "color": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"policy": {"const": "explicit"}},
        "required": ["policy"]
      },
      "then": {
        "required": ["assignments"],
        "properties": {"assignments": {"minItems": 1}}
      }
    },
    {
      "if": {
        "properties": {"policy": {"enum": ["preserve", "compact"]}},
        "required": ["policy"]
      },
      "then": {
        "properties": {"assignments": {"maxItems": 0}}
      }
    }
  ]
}
